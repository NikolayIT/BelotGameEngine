<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 rather than netstandard2.0: the search's hot path relies on BitOperations and
         [InlineArray], which netstandard2.0 does not have. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <CodeAnalysisRuleSet>..\..\Rules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="..\..\stylecop.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The trained networks (see NEURAL_NETWORK.md), built into the assembly. -->
    <EmbeddedResource Include="Neural\Weights\*.bin" LogicalName="Belot.AI.ClaudePlayer.Neural.Weights.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Neural\Weights\Ownership\*.bin" LogicalName="Belot.AI.ClaudePlayer.Neural.Weights.Ownership.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Belot.Engine\Belot.Engine.csproj" />
    <ProjectReference Include="..\Belot.AI.SmartPlayer\Belot.AI.SmartPlayer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>$(AssemblyName).Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NeuralTrainer</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
