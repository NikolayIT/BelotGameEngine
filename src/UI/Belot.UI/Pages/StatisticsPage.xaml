<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Belot.UI.Localization"
             xmlns:ui="clr-namespace:Belot.UI.Scaling"
             x:Class="Belot.UI.Pages.StatisticsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource FeltDark}">

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.3" Radius="0.95">
                <GradientStop Color="{StaticResource FeltLight}" Offset="0.0" />
                <GradientStop Color="{StaticResource FeltMid}" Offset="0.55" />
                <GradientStop Color="{StaticResource FeltDark}" Offset="1.0" />
            </RadialGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout x:Name="ContentColumn" Padding="{ui:Size '24,20,24,32'}"
                                 Spacing="{ui:Size '14'}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Start">

                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{ui:Size '10'}">
                    <Button Grid.Column="0"
                            Text="‹"
                            Clicked="OnBack"
                            HeightRequest="{ui:Size '36'}"
                            WidthRequest="{ui:Size '40'}"
                            Padding="{ui:Size '0,0,0,4'}"
                            FontSize="{ui:Size '22'}"
                            FontAttributes="Bold"
                            CornerRadius="{ui:Size '12'}"
                            BackgroundColor="#26000000"
                            BorderColor="#3FE2B864"
                            BorderWidth="1"
                            TextColor="{StaticResource GoldHighlight}" />
                    <Label Grid.Column="1"
                           Text="{loc:Tr Stats_Title}"
                           FontSize="{ui:Size '24'}"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           TextColor="{StaticResource GoldHighlight}" />
                </Grid>

                <!-- Rating tiles -->
                <Label Text="{loc:Tr Stats_Rating}"
                       FontSize="{ui:Size '11'}"
                       TextColor="{StaticResource GoldAccent}"
                       CharacterSpacing="3"
                       Margin="{ui:Size '0,8,0,0'}" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="{ui:Size '10'}" RowSpacing="{ui:Size '10'}">
                    <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="#26000000" Padding="{ui:Size '16,12'}">
                        <VerticalStackLayout Spacing="{ui:Size '2'}">
                            <Label Text="{loc:Tr Stats_Current}" FontSize="{ui:Size '11'}" TextColor="#C7D2BD" />
                            <Label x:Name="CurrentEloLabel" FontSize="{ui:Size '26'}" FontAttributes="Bold" TextColor="{StaticResource GoldHighlight}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="#26000000" Padding="{ui:Size '16,12'}">
                        <VerticalStackLayout Spacing="{ui:Size '2'}">
                            <Label Text="{loc:Tr Stats_Peak}" FontSize="{ui:Size '11'}" TextColor="#C7D2BD" />
                            <Label x:Name="PeakEloLabel" FontSize="{ui:Size '26'}" FontAttributes="Bold" TextColor="{StaticResource GoldHighlight}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="#26000000" Padding="{ui:Size '16,12'}">
                        <VerticalStackLayout Spacing="{ui:Size '2'}">
                            <Label Text="{loc:Tr Stats_Games}" FontSize="{ui:Size '11'}" TextColor="#C7D2BD" />
                            <Label x:Name="GamesLabel" FontSize="{ui:Size '26'}" FontAttributes="Bold" TextColor="White" />
                            <Label x:Name="WinLossLabel" FontSize="{ui:Size '11'}" TextColor="#B9C7B0" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="#26000000" Padding="{ui:Size '16,12'}">
                        <VerticalStackLayout Spacing="{ui:Size '2'}">
                            <Label Text="{loc:Tr Stats_WinRate}" FontSize="{ui:Size '11'}" TextColor="#C7D2BD" />
                            <Label x:Name="WinRateLabel" FontSize="{ui:Size '26'}" FontAttributes="Bold" TextColor="White" />
                            <Label x:Name="StreakLabel" FontSize="{ui:Size '11'}" TextColor="#B9C7B0" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label x:Name="EmptyLabel"
                       Text="{loc:Tr Stats_Empty}"
                       FontSize="{ui:Size '13'}"
                       TextColor="#B9C7B0"
                       Margin="{ui:Size '0,6,0,0'}" />

                <!-- Per-opponent results -->
                <Label x:Name="ByLevelCaption"
                       Text="{loc:Tr Stats_ByLevel}"
                       FontSize="{ui:Size '11'}"
                       TextColor="{StaticResource GoldAccent}"
                       CharacterSpacing="3"
                       Margin="{ui:Size '0,8,0,0'}" />

                <VerticalStackLayout x:Name="LevelListHost" Spacing="{ui:Size '8'}" />

                <!-- Full history -->
                <Label x:Name="HistoryCaption"
                       Text="{loc:Tr Stats_HistoryHeader}"
                       FontSize="{ui:Size '11'}"
                       TextColor="{StaticResource GoldAccent}"
                       CharacterSpacing="3"
                       Margin="{ui:Size '0,8,0,0'}" />

                <VerticalStackLayout x:Name="HistoryListHost" Spacing="{ui:Size '6'}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
