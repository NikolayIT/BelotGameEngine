<?xml version="1.0" encoding="utf-8" ?>
<!--
    Table sizes follow the available content area with modest growth on tablets
    ({ui:TableSize n}, see Game/UiScale.cs). Android system bars stay outside this area.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:game="clr-namespace:Belot.UI.Game"
             xmlns:controls="clr-namespace:Belot.UI.Controls"
             xmlns:conv="clr-namespace:Belot.UI.Converters"
             xmlns:loc="clr-namespace:Belot.UI.Localization"
             xmlns:ui="clr-namespace:Belot.UI.Scaling"
             x:Class="Belot.UI.Pages.GamePage"
             x:Name="ThePage"
             x:DataType="game:GameViewModel"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="Container"
             BackgroundColor="{StaticResource FeltDark}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:HexToColorConverter x:Key="HexToColor" />

            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="{ui:TableSize '9,4'}" />
                <Setter Property="BackgroundColor" Value="#33000000" />
            </Style>
            <Style x:Key="Bubble" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="{ui:TableSize '8,2'}" />
                <Setter Property="BackgroundColor" Value="#F8F4E6" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>
            <Style x:Key="DealerChip" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 6" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="{ui:TableSize '5,0'}" />
                <Setter Property="BackgroundColor" Value="{StaticResource GoldAccent}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>
            <Style x:Key="TableCard" TargetType="Border">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Shadow">
                    <Shadow Brush="Black" Opacity="0.6" Radius="8" Offset="2,3" />
                </Setter>
            </Style>
            <Style x:Key="TableCardImage" TargetType="Image">
                <Setter Property="WidthRequest" Value="{ui:TableSize 66}" />
                <Setter Property="HeightRequest" Value="{ui:TableSize 92}" />
                <Setter Property="Aspect" Value="AspectFit" />
            </Style>
            <Style x:Key="MiniCard" TargetType="Image">
                <Setter Property="WidthRequest" Value="{ui:TableSize 24}" />
                <Setter Property="HeightRequest" Value="{ui:TableSize 33}" />
            </Style>
            <Style x:Key="BidButton" TargetType="Button">
                <Setter Property="MinimumHeightRequest" Value="{ui:TableSize 44}" />
                <Setter Property="CornerRadius" Value="{ui:TableSize 10}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="BorderColor" Value="#33000000" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="Padding" Value="{ui:TableSize '4,0'}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="TableHost" SizeChanged="OnTableHostSizeChanged">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.5" Radius="1.0">
                <GradientStop Color="{StaticResource FeltLight}" Offset="0.0" />
                <GradientStop Color="{StaticResource FeltMid}" Offset="0.45" />
                <GradientStop Color="{StaticResource FeltDark}" Offset="1.0" />
            </RadialGradientBrush>
        </Grid.Background>

        <!-- ===== The table (never wider than a tall tablet: a wide window keeps the four seats together) ===== -->
        <Grid x:Name="TableGrid" Padding="{ui:TableSize '8,8'}" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="{ui:TableSize 4}" HorizontalOptions="Center" VerticalOptions="Center">

            <!-- Row 0: the scores and the menu; under them the contract and the hanging points (the line keeps its height) -->
            <Grid Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="{ui:TableSize 4}">
                <Grid x:Name="ScoreGrid" Grid.Row="0" Grid.Column="0" ColumnDefinitions="*,*" WidthRequest="{ui:TableSize 140}" MaximumWidthRequest="{ui:TableSize 230}" HorizontalOptions="Start" ColumnSpacing="{ui:TableSize 6}">
                    <Border Grid.Column="0" Style="{StaticResource Pill}" BackgroundColor="{StaticResource GoldHighlight}">
                        <VerticalStackLayout Spacing="{ui:TableSize 0}">
                            <Label Text="{loc:Tr Game_Us}" TextColor="#1A1006" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 10}" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding UsPoints}" SemanticProperties.Description="{Binding UsPointsDisplay}" TextColor="#1A1006"
                                   FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 14}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Pill}" BackgroundColor="#1A1006">
                        <VerticalStackLayout Spacing="{ui:TableSize 0}">
                            <Label Text="{loc:Tr Game_Them}" TextColor="#D8C9A0" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 10}" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding ThemPoints}" SemanticProperties.Description="{Binding ThemPointsDisplay}" TextColor="{StaticResource GoldHighlight}"
                                   FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 14}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <Button Grid.Row="0" Grid.Column="1" Text="{loc:Tr Game_Menu}" Clicked="OnMenuClicked" HorizontalOptions="End" VerticalOptions="Start"
                        MinimumHeightRequest="{ui:TableSize 44}" MinimumWidthRequest="{ui:TableSize 56}" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 13}" Padding="{ui:TableSize '10,0'}" CornerRadius="{ui:TableSize 10}"
                        BackgroundColor="#88000000" BorderColor="#55FFFFFF" BorderWidth="1" TextColor="White" />
                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="{ui:TableSize 6}" MinimumHeightRequest="{ui:TableSize 28}">
                    <Border Grid.Column="0" Style="{StaticResource Pill}" BackgroundColor="#F8F4E6" IsVisible="{Binding HasContract}">
                        <Label FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 13}" LineBreakMode="TailTruncation" MaxLines="1">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 13}" Text="{Binding ContractText}" FontAttributes="Bold" TextColor="{Binding ContractColor, Converter={StaticResource HexToColor}}" />
                                    <Span FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 13}" Text=" · " TextColor="#6F5A2A" />
                                    <Span FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 13}" Text="{Binding DeclarerName}" TextColor="#1A1006" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Pill}" IsVisible="{Binding HasHanging}">
                        <Label TextColor="White" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 12}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 12}" Text="{loc:Tr Game_Hanging}" />
                                    <Span FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 12}" Text=" " />
                                    <Span FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 12}" Text="{Binding HangingPoints}" FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                </Grid>
            </Grid>

            <!-- Row 1: the last trick | North, the partner -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Start" VerticalOptions="Center" Spacing="{ui:TableSize 1}" IsVisible="{Binding HasLastTrick}">
                    <Label Text="{loc:Tr Game_LastTrick}" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 10}" TextColor="#B9C7B0" HorizontalOptions="Center" />
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto" RowSpacing="{ui:TableSize -9}" ColumnSpacing="{ui:TableSize -2}">
                        <Image Grid.Row="0" Grid.Column="1" Style="{StaticResource MiniCard}" ZIndex="{Binding North.LastTrickZIndex}" Source="{Binding LastTrickNorth.ImageSource, FallbackValue='card_back.png'}">
                            <SemanticProperties.Description>
                                <MultiBinding StringFormat="{}{0}: {1}">
                                    <Binding Path="North.Name" />
                                    <Binding Path="LastTrickNorth.Description" />
                                </MultiBinding>
                            </SemanticProperties.Description>
                        </Image>
                        <Image Grid.Row="1" Grid.Column="0" Style="{StaticResource MiniCard}" ZIndex="{Binding West.LastTrickZIndex}" Source="{Binding LastTrickWest.ImageSource, FallbackValue='card_back.png'}">
                            <SemanticProperties.Description>
                                <MultiBinding StringFormat="{}{0}: {1}">
                                    <Binding Path="West.Name" />
                                    <Binding Path="LastTrickWest.Description" />
                                </MultiBinding>
                            </SemanticProperties.Description>
                        </Image>
                        <Image Grid.Row="1" Grid.Column="2" Style="{StaticResource MiniCard}" ZIndex="{Binding East.LastTrickZIndex}" Source="{Binding LastTrickEast.ImageSource, FallbackValue='card_back.png'}">
                            <SemanticProperties.Description>
                                <MultiBinding StringFormat="{}{0}: {1}">
                                    <Binding Path="East.Name" />
                                    <Binding Path="LastTrickEast.Description" />
                                </MultiBinding>
                            </SemanticProperties.Description>
                        </Image>
                        <Image Grid.Row="2" Grid.Column="1" Style="{StaticResource MiniCard}" ZIndex="{Binding South.LastTrickZIndex}" Source="{Binding LastTrickSouth.ImageSource, FallbackValue='card_back.png'}">
                            <SemanticProperties.Description>
                                <MultiBinding StringFormat="{}{0}: {1}">
                                    <Binding Path="South.Name" />
                                    <Binding Path="LastTrickSouth.Description" />
                                </MultiBinding>
                            </SemanticProperties.Description>
                        </Image>
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="{ui:TableSize 3}" HorizontalOptions="Center" MaximumWidthRequest="{ui:TableSize 220}" BindingContext="{Binding North}" x:DataType="game:SeatViewModel">
                    <Border Style="{StaticResource Pill}" Opacity="{Binding TurnOpacity}" HorizontalOptions="Fill">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{ui:TableSize 6}">
                            <Ellipse Grid.Column="0" WidthRequest="{ui:TableSize 9}" HeightRequest="{ui:TableSize 9}" Fill="{StaticResource GoldAccentBrush}" VerticalOptions="Center" IsVisible="{Binding IsToMove}" />
                            <Label Grid.Column="1" Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 13}" VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                            <Border Grid.Column="2" Style="{StaticResource DealerChip}" IsVisible="{Binding IsDealer}">
                                <Label Text="{loc:Tr Game_Dealer}" TextColor="#1A1006" FontAttributes="Bold" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 10}" />
                            </Border>
                        </Grid>
                    </Border>
                    <HorizontalStackLayout Spacing="{ui:TableSize -23}" HorizontalOptions="Center" BindableLayout.ItemsSource="{Binding Backs}">
                        <SemanticProperties.Description>
                            <MultiBinding StringFormat="{}{0}: {1}">
                                <Binding Path="Name" />
                                <Binding Path="CardsDescription" />
                            </MultiBinding>
                        </SemanticProperties.Description>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="game:CardSlot">
                                <Image Source="{Binding ImageSource}" WidthRequest="{ui:TableSize 34}" HeightRequest="{ui:TableSize 47}" Aspect="AspectFit" AutomationProperties.ExcludedWithChildren="True" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                    <Border Style="{StaticResource Bubble}" IsVisible="{Binding HasBubble}">
                        <Label Text="{Binding BubbleText}" TextColor="#1A1006" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 13}" FontAttributes="Bold" />
                    </Border>
                    <Label Text="{Binding DeclaredText}" IsVisible="{Binding HasDeclared}" TextColor="#D8C9A0" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 10}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- Row 2: West | the trick | East -->
            <Grid Grid.Row="2" ColumnSpacing="{ui:TableSize 4}" x:Name="MiddleRow" IsClippedToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{ui:TableSize 80}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{ui:TableSize 80}" />
                </Grid.ColumnDefinitions>

                <!-- West -->
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{ui:TableSize 0}" VerticalOptions="Fill" HorizontalOptions="Fill" Margin="{ui:TableSize '0,6,0,0'}" BindingContext="{Binding West}" x:DataType="game:SeatViewModel">
                    <Border Grid.Row="0" Style="{StaticResource Pill}" Opacity="{Binding TurnOpacity}" Padding="{ui:TableSize '5,3'}" Margin="{ui:TableSize '0,0,0,4'}">
                        <VerticalStackLayout Spacing="{ui:TableSize 2}">
                            <Ellipse WidthRequest="{ui:TableSize 9}" HeightRequest="{ui:TableSize 9}" Fill="{StaticResource GoldAccentBrush}" HorizontalOptions="Center" IsVisible="{Binding IsToMove}" />
                            <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 12}" MaxLines="2" LineBreakMode="TailTruncation" HorizontalTextAlignment="Center" />
                            <Border Style="{StaticResource DealerChip}" IsVisible="{Binding IsDealer}">
                                <Label Text="{loc:Tr Game_Dealer}" TextColor="#1A1006" FontAttributes="Bold" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 10}" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Bubble}" IsVisible="{Binding HasBubble}" Margin="{ui:TableSize '0,0,0,4'}">
                        <Label Text="{Binding BubbleText}" TextColor="#1A1006" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 13}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    </Border>
                    <Label Grid.Row="2" Margin="{ui:TableSize '0,0,0,4'}" Text="{Binding DeclaredText}" IsVisible="{Binding HasDeclared}" TextColor="#D8C9A0" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 10}" HorizontalTextAlignment="Center" />
                    <controls:VerticalCardBackLayout Grid.Row="3" CardScale="{ui:TableSize 1}" HorizontalOptions="Fill" VerticalOptions="Fill" BindableLayout.ItemsSource="{Binding Backs}">
                        <SemanticProperties.Description>
                            <MultiBinding StringFormat="{}{0}: {1}">
                                <Binding Path="Name" />
                                <Binding Path="CardsDescription" />
                            </MultiBinding>
                        </SemanticProperties.Description>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="game:CardSlot">
                                <Image Source="{Binding ImageSource}" Aspect="AspectFit" AutomationProperties.ExcludedWithChildren="True" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </controls:VerticalCardBackLayout>
                </Grid>

                <!-- The trick in progress -->
                <Grid Grid.Column="1">
                    <Border x:Name="NorthPlayed" Style="{StaticResource TableCard}" TranslationY="{ui:TableSize -56}" Rotation="-3"
                            IsVisible="{Binding North.HasPlayedCard}" ZIndex="{Binding North.PlayedCardZIndex}">
                        <SemanticProperties.Description>
                            <MultiBinding StringFormat="{}{0}: {1}">
                                <Binding Path="North.Name" />
                                <Binding Path="North.PlayedCard.Description" />
                            </MultiBinding>
                        </SemanticProperties.Description>
                        <Image Style="{StaticResource TableCardImage}" Source="{Binding North.PlayedCard.ImageSource, FallbackValue='card_back.png'}" />
                    </Border>
                    <Border x:Name="WestPlayed" Style="{StaticResource TableCard}" TranslationX="{ui:TableSize -50}" Rotation="-6"
                            IsVisible="{Binding West.HasPlayedCard}" ZIndex="{Binding West.PlayedCardZIndex}">
                        <SemanticProperties.Description>
                            <MultiBinding StringFormat="{}{0}: {1}">
                                <Binding Path="West.Name" />
                                <Binding Path="West.PlayedCard.Description" />
                            </MultiBinding>
                        </SemanticProperties.Description>
                        <Image Style="{StaticResource TableCardImage}" Source="{Binding West.PlayedCard.ImageSource, FallbackValue='card_back.png'}" />
                    </Border>
                    <Border x:Name="EastPlayed" Style="{StaticResource TableCard}" TranslationX="{ui:TableSize 50}" Rotation="5"
                            IsVisible="{Binding East.HasPlayedCard}" ZIndex="{Binding East.PlayedCardZIndex}">
                        <SemanticProperties.Description>
                            <MultiBinding StringFormat="{}{0}: {1}">
                                <Binding Path="East.Name" />
                                <Binding Path="East.PlayedCard.Description" />
                            </MultiBinding>
                        </SemanticProperties.Description>
                        <Image Style="{StaticResource TableCardImage}" Source="{Binding East.PlayedCard.ImageSource, FallbackValue='card_back.png'}" />
                    </Border>
                    <Border x:Name="SouthPlayed" Style="{StaticResource TableCard}" TranslationY="{ui:TableSize 56}" Rotation="3"
                            IsVisible="{Binding South.HasPlayedCard}" ZIndex="{Binding South.PlayedCardZIndex}">
                        <SemanticProperties.Description>
                            <MultiBinding StringFormat="{}{0}: {1}">
                                <Binding Path="South.Name" />
                                <Binding Path="South.PlayedCard.Description" />
                            </MultiBinding>
                        </SemanticProperties.Description>
                        <Image Style="{StaticResource TableCardImage}" Source="{Binding South.PlayedCard.ImageSource, FallbackValue='card_back.png'}" />
                    </Border>
                </Grid>

                <!-- East -->
                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{ui:TableSize 0}" VerticalOptions="Fill" HorizontalOptions="Fill" Margin="{ui:TableSize '0,6,0,0'}" BindingContext="{Binding East}" x:DataType="game:SeatViewModel">
                    <Border Grid.Row="0" Style="{StaticResource Pill}" Opacity="{Binding TurnOpacity}" Padding="{ui:TableSize '5,3'}" Margin="{ui:TableSize '0,0,0,4'}">
                        <VerticalStackLayout Spacing="{ui:TableSize 2}">
                            <Ellipse WidthRequest="{ui:TableSize 9}" HeightRequest="{ui:TableSize 9}" Fill="{StaticResource GoldAccentBrush}" HorizontalOptions="Center" IsVisible="{Binding IsToMove}" />
                            <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 12}" MaxLines="2" LineBreakMode="TailTruncation" HorizontalTextAlignment="Center" />
                            <Border Style="{StaticResource DealerChip}" IsVisible="{Binding IsDealer}">
                                <Label Text="{loc:Tr Game_Dealer}" TextColor="#1A1006" FontAttributes="Bold" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 10}" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Bubble}" IsVisible="{Binding HasBubble}" Margin="{ui:TableSize '0,0,0,4'}">
                        <Label Text="{Binding BubbleText}" TextColor="#1A1006" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 13}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    </Border>
                    <Label Grid.Row="2" Margin="{ui:TableSize '0,0,0,4'}" Text="{Binding DeclaredText}" IsVisible="{Binding HasDeclared}" TextColor="#D8C9A0" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 10}" HorizontalTextAlignment="Center" />
                    <controls:VerticalCardBackLayout Grid.Row="3" CardScale="{ui:TableSize 1}" HorizontalOptions="Fill" VerticalOptions="Fill" BindableLayout.ItemsSource="{Binding Backs}">
                        <SemanticProperties.Description>
                            <MultiBinding StringFormat="{}{0}: {1}">
                                <Binding Path="Name" />
                                <Binding Path="CardsDescription" />
                            </MultiBinding>
                        </SemanticProperties.Description>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="game:CardSlot">
                                <Image Source="{Binding ImageSource}" Aspect="AspectFit" AutomationProperties.ExcludedWithChildren="True" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </controls:VerticalCardBackLayout>
                </Grid>
            </Grid>

            <!-- Bidding stays beside the hand, leaving the seats and table visible. -->
            <Border Grid.Row="3" IsVisible="{Binding IsBidPanelVisible}" x:Name="BidPanel"
                    StrokeShape="RoundRectangle 12" Stroke="#496B5C" StrokeThickness="1" BackgroundColor="#E612312A"
                    Padding="{ui:TableSize '10,8'}" HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="{ui:TableSize 5}">
                        <Label Text="{Binding CurrentBidText}" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 11}" TextColor="#C7D2BD" LineBreakMode="TailTruncation" MaxLines="1" />
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{ui:TableSize 5}">
                            <Button Grid.Column="0" BindingContext="{Binding BidOptions[0]}" x:DataType="game:BidOption"
                                    Style="{StaticResource BidButton}" Text="♣" SemanticProperties.Description="{Binding Text}" FontSize="{ui:TableSize 22}"
                                    IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" TextColor="{Binding TextColor, Converter={StaticResource HexToColor}}" FontAutoScalingEnabled="False"
                                    Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                        <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                        <Setter Property="BorderWidth" Value="3" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1" BindingContext="{Binding BidOptions[1]}" x:DataType="game:BidOption"
                                    Style="{StaticResource BidButton}" Text="♦" SemanticProperties.Description="{Binding Text}" FontSize="{ui:TableSize 22}"
                                    IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" TextColor="{Binding TextColor, Converter={StaticResource HexToColor}}" FontAutoScalingEnabled="False"
                                    Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                        <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                        <Setter Property="BorderWidth" Value="3" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="2" BindingContext="{Binding BidOptions[2]}" x:DataType="game:BidOption"
                                    Style="{StaticResource BidButton}" Text="♥" SemanticProperties.Description="{Binding Text}" FontSize="{ui:TableSize 22}"
                                    IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" TextColor="{Binding TextColor, Converter={StaticResource HexToColor}}" FontAutoScalingEnabled="False"
                                    Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                        <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                        <Setter Property="BorderWidth" Value="3" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="3" BindingContext="{Binding BidOptions[3]}" x:DataType="game:BidOption"
                                    Style="{StaticResource BidButton}" Text="♠" SemanticProperties.Description="{Binding Text}" FontSize="{ui:TableSize 22}"
                                    IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" TextColor="{Binding TextColor, Converter={StaticResource HexToColor}}" FontAutoScalingEnabled="False"
                                    Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                        <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                        <Setter Property="BorderWidth" Value="3" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,Auto,*" ColumnSpacing="{ui:TableSize 5}">
                            <Button Grid.Column="0" BindingContext="{Binding BidOptions[4]}" x:DataType="game:BidOption"
                                    Style="{StaticResource BidButton}" Text="{Binding Text}" SemanticProperties.Description="{Binding Text}" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 13}"
                                    IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" TextColor="#1A1006"
                                    Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                        <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                        <Setter Property="BorderWidth" Value="3" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1" BindingContext="{Binding BidOptions[5]}" x:DataType="game:BidOption"
                                    Style="{StaticResource BidButton}" Text="{Binding Text}" SemanticProperties.Description="{Binding Text}" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 13}"
                                    IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" TextColor="#1A1006"
                                    Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                        <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                        <Setter Property="BorderWidth" Value="3" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="3" BindingContext="{Binding BidOptions[8]}" x:DataType="game:BidOption"
                                    Style="{StaticResource BidButton}" Text="{Binding Text}" SemanticProperties.Description="{Binding Text}" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 13}"
                                    IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" TextColor="#1A1006" BackgroundColor="{StaticResource GoldAccent}"
                                    Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                        <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                        <Setter Property="BorderWidth" Value="3" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="2" MinimumWidthRequest="{ui:TableSize 64}" BindingContext="{Binding BidOptions[6]}" x:DataType="game:BidOption"
                                    Style="{StaticResource BidButton}" Text="{Binding Text}" SemanticProperties.Description="{Binding Text}" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 13}"
                                    IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" TextColor="#8A1C1C" IsVisible="{Binding IsVisible}"
                                    Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                        <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                        <Setter Property="BorderWidth" Value="3" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="2" MinimumWidthRequest="{ui:TableSize 64}" BindingContext="{Binding BidOptions[7]}" x:DataType="game:BidOption"
                                    Style="{StaticResource BidButton}" Text="{Binding Text}" SemanticProperties.Description="{Binding Text}" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 13}"
                                    IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}" TextColor="#8A1C1C" IsVisible="{Binding IsVisible}"
                                    Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                        <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                        <Setter Property="BorderWidth" Value="3" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </VerticalStackLayout>
            </Border>

            <!-- Declaration panel -->
            <Border Grid.Row="3" IsVisible="{Binding IsAnnouncePanelVisible}" x:Name="AnnouncePanel"
                    StrokeShape="RoundRectangle 12" Stroke="#496B5C" StrokeThickness="1" BackgroundColor="#E612312A"
                    Padding="{ui:TableSize '10,8'}" HorizontalOptions="Fill">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="8" Offset="0,3" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="{ui:TableSize 6}">
                    <Label Text="{loc:Tr Game_YourCombinations}" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 13}" FontAttributes="Bold" TextColor="#F4D586" HorizontalOptions="Center" />
                    <ScrollView MaximumHeightRequest="{ui:TableSize 90}" VerticalScrollBarVisibility="Always">
                        <VerticalStackLayout Spacing="{ui:TableSize 4}" BindableLayout.ItemsSource="{Binding AnnounceOptions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="game:AnnounceOption">
                                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#F8F4E6" Padding="{ui:TableSize '10,6'}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{ui:TableSize 10}">
                                            <Label Grid.Column="0" Text="{Binding Mark}" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 20}" TextColor="#0B3D1A" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Text}" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 15}" TextColor="#1A1006" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding Points}" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 15}" FontAttributes="Bold" TextColor="#6F5A2A" VerticalOptions="Center" />
                                            <Border Grid.ColumnSpan="3" IsVisible="{Binding IsHinted}" InputTransparent="True"
                                                    BackgroundColor="Transparent" Stroke="{StaticResource GoldAccent}" StrokeThickness="2" StrokeShape="RoundRectangle 6" />
                                            <Button Grid.ColumnSpan="3" BackgroundColor="Transparent" BorderWidth="0" Padding="{ui:TableSize 0}"
                                                    SemanticProperties.Description="{Binding Description}"
                                                    Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.ToggleAnnounceCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                    <Button Text="{Binding DeclareButtonText}" Command="{Binding DeclareCommand}" MinimumHeightRequest="{ui:TableSize 40}" CornerRadius="{ui:TableSize 10}"
                            FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 16}" FontAttributes="Bold" BackgroundColor="{StaticResource GoldAccent}" TextColor="#1A1006" />
                </VerticalStackLayout>
            </Border>

            <!-- Constrain the name independently of the actions, including pasted long names. -->
            <Border Grid.Row="4" Style="{StaticResource Pill}" Padding="{ui:TableSize '12,4,5,4'}">
                <Grid x:Name="SouthBar" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{ui:TableSize 8}" RowSpacing="{ui:TableSize 2}">
                    <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{ui:TableSize 7}" VerticalOptions="Center"
                          BindingContext="{Binding South}" x:DataType="game:SeatViewModel" Opacity="{Binding TurnOpacity}">
                        <Ellipse Grid.Column="0" WidthRequest="{ui:TableSize 10}" HeightRequest="{ui:TableSize 10}" Fill="{StaticResource GoldAccentBrush}" VerticalOptions="Center" IsVisible="{Binding IsToMove}" />
                        <Label Grid.Column="1" x:Name="SouthName" Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 14}"
                               VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding DeclaredText}" IsVisible="{Binding HasDeclared}" TextColor="#D8C9A0"
                               FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 10}" LineBreakMode="TailTruncation" MaxLines="1" />
                        <Border Grid.Column="2" Style="{StaticResource DealerChip}" IsVisible="{Binding IsDealer}">
                            <Label Text="{loc:Tr Game_Dealer}" TextColor="#1A1006" FontAttributes="Bold" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 10}" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="{ui:TableSize 6}">
                        <Border Grid.Column="0" Style="{StaticResource Bubble}" IsVisible="{Binding South.HasBubble}">
                            <Label Text="{Binding South.BubbleText}" TextColor="#1A1006" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 12}" FontAttributes="Bold" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding StatusMessage}" TextColor="#E6FFFFFF" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 12}"
                               VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                    </Grid>
                    <Button Grid.Column="1" Grid.RowSpan="2" Text="{loc:Tr Game_Hint}" Command="{Binding HintCommand}" IsVisible="{Binding IsHintVisible}"
                            VerticalOptions="Center" MinimumHeightRequest="{ui:TableSize 40}" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 12}" FontAttributes="Bold" Padding="{ui:TableSize '12,0'}"
                            CornerRadius="{ui:TableSize 10}" BackgroundColor="#26FFFFFF" BorderColor="{StaticResource GoldAccent}" BorderWidth="1" TextColor="{StaticResource GoldHighlight}" />
                </Grid>
            </Border>

            <!-- Row 5: my hand (the gap follows the width, so eight cards always fit) -->
            <HorizontalStackLayout Grid.Row="5" x:Name="HandStack" HorizontalOptions="Center" Margin="{ui:TableSize '0,2,0,2'}" BindableLayout.ItemsSource="{Binding MyHand}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="game:CardSlot">
                        <Border StrokeThickness="0" Stroke="Transparent" StrokeShape="RoundRectangle 6" BackgroundColor="Black">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.6" Radius="8" Offset="2,3" />
                            </Border.Shadow>
                            <Grid WidthRequest="{ui:TableSize 70}" HeightRequest="{ui:TableSize 98}">
                                <ImageButton Source="{Binding ImageSource}" Opacity="{Binding FaceOpacity}" WidthRequest="{ui:TableSize 70}" HeightRequest="{ui:TableSize 98}" Aspect="AspectFit"
                                             BackgroundColor="Transparent" Padding="{ui:TableSize 0}" SemanticProperties.Description="{Binding Description}"
                                             Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.TapCardCommand}" CommandParameter="{Binding}" />
                                <Border IsVisible="{Binding IsHinted}" InputTransparent="True" BackgroundColor="Transparent"
                                        Stroke="{StaticResource GoldHighlight}" StrokeThickness="3" StrokeShape="RoundRectangle 6" />
                                <!-- Dim the face over an opaque backing so overlapping cards cannot show through. -->
                                <Border IsVisible="{Binding HasBadge}" StrokeShape="RoundRectangle 6" StrokeThickness="0" BackgroundColor="{StaticResource GoldHighlight}"
                                        InputTransparent="True" Padding="{ui:TableSize '4,1'}" HorizontalOptions="Start" VerticalOptions="End" Margin="{ui:TableSize '3,0,0,5'}">
                                    <Label Text="{Binding BadgeText}" TextColor="#1A1006" FontAutoScalingEnabled="False" FontSize="{ui:TableTextSize 10}" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </Grid>

        <!-- ===== Toast ===== -->
        <Border x:Name="ToastBorder" IsVisible="{Binding IsToastVisible}" StrokeShape="RoundRectangle 16" Stroke="#1A1006" StrokeThickness="2"
                BackgroundColor="{StaticResource GoldHighlight}" Padding="{ui:TableSize '26,14'}" HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="{ui:TableSize 420}"
                InputTransparent="True">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.7" Radius="20" Offset="0,4" />
            </Border.Shadow>
            <Label Text="{Binding ToastMessage}" TextColor="#1A1006" FontAttributes="Bold" FontSize="{ui:TableSize 22}" HorizontalTextAlignment="Center" />
        </Border>

        <!-- ===== End of a deal ===== -->
        <Grid x:Name="RoundOverlayRoot" IsVisible="{Binding IsRoundOverlayVisible}" BackgroundColor="#D9000000">
            <ScrollView VerticalOptions="Fill">
                <Border StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="#F8F4E6" Padding="{ui:TableSize '22,20'}" Margin="{ui:TableSize 16}"
                        HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="{ui:TableSize 420}" BindingContext="{Binding RoundResult}" x:DataType="game:RoundResultModel">
                    <VerticalStackLayout Spacing="{ui:TableSize 12}">
                        <Label Text="{Binding Icon}" FontSize="{ui:TableSize 44}" HorizontalOptions="Center" />
                        <Label Text="{Binding Title}" FontSize="{ui:TableSize 24}" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="#0B3D1A" />
                        <Label Text="{Binding ContractLine}" FontSize="{ui:TableSize 14}" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="#6F5A2A" />
                        <Border IsVisible="{Binding IsCapot}" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#C0504D" Padding="{ui:TableSize '12,3'}" HorizontalOptions="Center">
                            <Label Text="{loc:Tr Round_CapotBadge}" TextColor="White" FontAttributes="Bold" FontSize="{ui:TableSize 14}" />
                        </Border>

                        <Border IsVisible="{Binding IsPlayed}" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#0B3D1A" Padding="{ui:TableSize '14,10'}">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{ui:TableSize 4}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{ui:TableSize 72}" />
                                    <ColumnDefinition Width="{ui:TableSize 72}" />
                                </Grid.ColumnDefinitions>
                                <Label Grid.Row="0" Grid.Column="1" Text="{loc:Tr Game_Us}" FontSize="{ui:TableSize 14}" TextColor="#E2B864" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Grid.Row="0" Grid.Column="2" Text="{loc:Tr Game_Them}" FontSize="{ui:TableSize 14}" TextColor="#E2B864" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{loc:Tr Round_Cards}" TextColor="#C7D2BD" FontSize="{ui:TableSize 13}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding UsCards}" FontSize="{ui:TableSize 15}" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Row="1" Grid.Column="2" Text="{Binding ThemCards}" FontSize="{ui:TableSize 15}" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Row="2" Grid.Column="0" Text="{loc:Tr Round_Combinations}" TextColor="#C7D2BD" FontSize="{ui:TableSize 13}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding UsCombinations}" FontSize="{ui:TableSize 15}" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Row="2" Grid.Column="2" Text="{Binding ThemCombinations}" FontSize="{ui:TableSize 15}" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Row="3" Grid.Column="0" Text="{loc:Tr Round_Capot}" TextColor="#C7D2BD" FontSize="{ui:TableSize 13}" />
                                <Label Grid.Row="3" Grid.Column="1" Text="{Binding UsCapot}" FontSize="{ui:TableSize 15}" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Row="3" Grid.Column="2" Text="{Binding ThemCapot}" FontSize="{ui:TableSize 15}" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Row="4" Grid.Column="0" Text="{loc:Tr Round_InDeal}" TextColor="#E2B864" FontSize="{ui:TableSize 13}" FontAttributes="Bold" />
                                <Label Grid.Row="4" Grid.Column="1" Text="{Binding UsInDeal}" FontSize="{ui:TableSize 15}" TextColor="{StaticResource GoldHighlight}" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Grid.Row="4" Grid.Column="2" Text="{Binding ThemInDeal}" FontSize="{ui:TableSize 15}" TextColor="{StaticResource GoldHighlight}" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Grid.Row="5" Grid.Column="0" Text="{loc:Tr Round_GamePoints}" TextColor="#E2B864" FontSize="{ui:TableSize 13}" FontAttributes="Bold" />
                                <Label Grid.Row="5" Grid.Column="1" Text="{Binding UsAwarded}" TextColor="{StaticResource GoldHighlight}" FontAttributes="Bold" FontSize="{ui:TableSize 18}" HorizontalOptions="Center" />
                                <Label Grid.Row="5" Grid.Column="2" Text="{Binding ThemAwarded}" TextColor="{StaticResource GoldHighlight}" FontAttributes="Bold" FontSize="{ui:TableSize 18}" HorizontalOptions="Center" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout IsVisible="{Binding HasCombinations}" Spacing="{ui:TableSize 2}">
                            <Label FontSize="{ui:TableSize 13}" TextColor="#1A1006" HorizontalTextAlignment="Center" IsVisible="{Binding HasUsCombinations}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span FontSize="{ui:TableSize 13}" Text="{loc:Tr Game_Us}" FontAttributes="Bold" />
                                        <Span FontSize="{ui:TableSize 13}" Text=": " />
                                        <Span FontSize="{ui:TableSize 13}" Text="{Binding UsCombinationsText}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="{ui:TableSize 13}" TextColor="#1A1006" HorizontalTextAlignment="Center" IsVisible="{Binding HasThemCombinations}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span FontSize="{ui:TableSize 13}" Text="{loc:Tr Game_Them}" FontAttributes="Bold" />
                                        <Span FontSize="{ui:TableSize 13}" Text=": " />
                                        <Span FontSize="{ui:TableSize 13}" Text="{Binding ThemCombinationsText}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>

                        <Label Text="{Binding HangingText}" IsVisible="{Binding HasHanging}" FontSize="{ui:TableSize 13}" TextColor="#6F5A2A" HorizontalOptions="Center" HorizontalTextAlignment="Center" />

                        <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="{StaticResource GoldAccent}" Padding="{ui:TableSize '16,6'}">
                            <VerticalStackLayout>
                                <Label Text="{loc:Tr Round_Score}" FontSize="{ui:TableSize 11}" CharacterSpacing="2" HorizontalOptions="Center" TextColor="#7A5C20" />
                                <Label HorizontalOptions="Center" TextColor="#1A1006" FontSize="{ui:TableSize 24}" FontAttributes="Bold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span FontSize="{ui:TableSize 24}" Text="{Binding UsTotal}" />
                                            <Span FontSize="{ui:TableSize 24}" Text="  –  " />
                                            <Span FontSize="{ui:TableSize 24}" Text="{Binding ThemTotal}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <Button Text="{loc:Tr Common_Continue}" Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.RoundOverlayContinueCommand}"
                                BackgroundColor="{StaticResource GoldAccent}" TextColor="#1A1006" FontAttributes="Bold" FontSize="{ui:TableSize 17}" MinimumHeightRequest="{ui:TableSize 50}" CornerRadius="{ui:TableSize 12}" />
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <!-- ===== End of the game ===== -->
        <Grid x:Name="GameOverlayRoot" IsVisible="{Binding IsGameOverlayVisible}" BackgroundColor="#E5000000">
            <ScrollView VerticalOptions="Fill">
            <Border StrokeShape="RoundRectangle 22" StrokeThickness="0" BackgroundColor="#F8F4E6" Padding="{ui:TableSize '28,26'}" Margin="{ui:TableSize 16}"
                    HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="{ui:TableSize 420}">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.7" Radius="24" Offset="0,4" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="{ui:TableSize 16}">
                    <Label Text="{Binding GameOverlayIcon}" FontSize="{ui:TableSize 52}" HorizontalOptions="Center" />
                    <Label Text="{Binding GameOverlayTitle}" FontSize="{ui:TableSize 30}" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="#0B3D1A" />
                    <Label Text="{Binding GameOverlayBody}" FontSize="{ui:TableSize 20}" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="#1A1006" />
                    <Border IsVisible="{Binding IsRatingChangeVisible}" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="#0B3D1A" Padding="{ui:TableSize '16,10'}">
                        <Label Text="{Binding RatingChangeText}" FontSize="{ui:TableSize 16}" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="{StaticResource GoldHighlight}" />
                    </Border>
                    <Border IsVisible="{Binding HasMatchHistory}" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#22000000" Padding="{ui:TableSize '12,5'}" HorizontalOptions="Center">
                        <Label FontSize="{ui:TableSize 14}" TextColor="#0B3D1A" FontAttributes="Bold">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span FontSize="{ui:TableSize 14}" Text="{loc:Tr Common_Series}" />
                                    <Span FontSize="{ui:TableSize 14}" Text="  " />
                                    <Span FontSize="{ui:TableSize 14}" Text="{Binding MatchScoreText}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                    <Button Text="{loc:Tr GameOver_PlayAgain}" Command="{Binding PlayAgainCommand}" BackgroundColor="{StaticResource GoldAccent}" TextColor="#1A1006"
                            FontAttributes="Bold" FontSize="{ui:TableSize 17}" MinimumHeightRequest="{ui:TableSize 50}" CornerRadius="{ui:TableSize 12}" />
                    <Button Text="{loc:Tr GameOver_BackToMenu}" Command="{Binding LeaveCommand}" BackgroundColor="Transparent" BorderColor="{StaticResource FeltMid}" BorderWidth="1"
                            TextColor="{StaticResource FeltMid}" FontAttributes="Bold" FontSize="{ui:TableSize 15}" MinimumHeightRequest="{ui:TableSize 46}" CornerRadius="{ui:TableSize 12}" />
                </VerticalStackLayout>
            </Border>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
