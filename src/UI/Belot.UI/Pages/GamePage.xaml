<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:game="clr-namespace:Belot.UI.Game"
             xmlns:conv="clr-namespace:Belot.UI.Converters"
             xmlns:loc="clr-namespace:Belot.UI.Localization"
             x:Class="Belot.UI.Pages.GamePage"
             x:Name="ThePage"
             x:DataType="game:GameViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource FeltDark}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />
            <conv:StringNotEmptyConverter x:Key="NotEmpty" />
            <conv:HexToColorConverter x:Key="HexToColor" />

            <!-- Card sizes: phone / desktop -->
            <OnIdiom x:Key="HandCardWidth" x:TypeArguments="x:Double" Phone="62" Default="96" />
            <OnIdiom x:Key="HandCardHeight" x:TypeArguments="x:Double" Phone="86" Default="134" />
            <OnIdiom x:Key="HandSpacing" x:TypeArguments="x:Double" Phone="-24" Default="-34" />
            <OnIdiom x:Key="TableCardWidth" x:TypeArguments="x:Double" Phone="62" Default="90" />
            <OnIdiom x:Key="TableCardHeight" x:TypeArguments="x:Double" Phone="86" Default="125" />
            <OnIdiom x:Key="BackWidth" x:TypeArguments="x:Double" Phone="30" Default="46" />
            <OnIdiom x:Key="BackHeight" x:TypeArguments="x:Double" Phone="42" Default="64" />
            <OnIdiom x:Key="BackSpacing" x:TypeArguments="x:Double" Phone="-20" Default="-30" />
            <OnIdiom x:Key="SideBackWidth" x:TypeArguments="x:Double" Phone="34" Default="50" />
            <OnIdiom x:Key="SideBackHeight" x:TypeArguments="x:Double" Phone="47" Default="70" />
            <OnIdiom x:Key="SideBackSpacing" x:TypeArguments="x:Double" Phone="-35" Default="-50" />
            <OnIdiom x:Key="SideColumn" x:TypeArguments="GridLength" Phone="70" Default="150" />
            <OnIdiom x:Key="MiniWidth" x:TypeArguments="x:Double" Phone="22" Default="34" />
            <OnIdiom x:Key="MiniHeight" x:TypeArguments="x:Double" Phone="30" Default="47" />

            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="BackgroundColor" Value="#33000000" />
            </Style>
            <Style x:Key="Bubble" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="BackgroundColor" Value="#F8F4E6" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>
            <Style x:Key="TableCard" TargetType="Border">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Shadow">
                    <Shadow Brush="Black" Opacity="0.6" Radius="8" Offset="2,3" />
                </Setter>
            </Style>
            <Style x:Key="BidButton" TargetType="Button">
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="BorderColor" Value="#33000000" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="Padding" Value="4,0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.5" Radius="1.0">
                <GradientStop Color="{StaticResource FeltLight}" Offset="0.0" />
                <GradientStop Color="{StaticResource FeltMid}" Offset="0.45" />
                <GradientStop Color="{StaticResource FeltDark}" Offset="1.0" />
            </RadialGradientBrush>
        </Grid.Background>

        <!-- ===== The table ===== -->
        <Grid Padding="8,10" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="4">

            <!-- Row 0: scores, hanging points, contract. Right margin keeps clear of the Menu button. -->
            <FlexLayout Grid.Row="0" Wrap="Wrap" AlignItems="Center" Margin="0,0,58,0">
                <Border Style="{StaticResource Pill}" Margin="0,0,6,4" BackgroundColor="{StaticResource GoldHighlight}">
                    <Label TextColor="#1A1006" FontSize="14">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{loc:Tr Game_Us}" />
                                <Span Text="  " />
                                <Span Text="{Binding UsPointsDisplay}" FontAttributes="Bold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Border>
                <Border Style="{StaticResource Pill}" Margin="0,0,6,4" BackgroundColor="#1A1006">
                    <Label TextColor="{StaticResource GoldHighlight}" FontSize="14">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{loc:Tr Game_Them}" TextColor="#D8C9A0" />
                                <Span Text="  " />
                                <Span Text="{Binding ThemPointsDisplay}" FontAttributes="Bold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Border>
                <Border Style="{StaticResource Pill}" Margin="0,0,6,4" IsVisible="{Binding HasHanging}">
                    <Label TextColor="White" FontSize="12">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{loc:Tr Game_Hanging}" />
                                <Span Text=" " />
                                <Span Text="{Binding HangingPoints}" FontAttributes="Bold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Border>
                <Border Style="{StaticResource Pill}" Margin="0,0,6,4" BackgroundColor="#F8F4E6" IsVisible="{Binding HasContract}">
                    <Label FontSize="13">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding ContractText}" FontAttributes="Bold" TextColor="{Binding ContractColor, Converter={StaticResource HexToColor}}" />
                                <Span Text=" · " TextColor="#6F5A2A" />
                                <Span Text="{Binding DeclarerName}" TextColor="#1A1006" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Border>
            </FlexLayout>

            <!-- Row 1: North, the partner -->
            <VerticalStackLayout Grid.Row="1" Spacing="3" HorizontalOptions="Center" BindingContext="{Binding North}" x:DataType="game:SeatViewModel">
                <Border Style="{StaticResource Pill}" Opacity="{Binding TurnOpacity}" HorizontalOptions="Center">
                    <HorizontalStackLayout Spacing="6">
                        <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource GoldAccentBrush}" VerticalOptions="Center" IsVisible="{Binding IsToMove}" />
                        <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" />
                        <Label Text="🂠" IsVisible="{Binding IsDealer}" TextColor="{StaticResource GoldHighlight}" FontSize="13" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <HorizontalStackLayout Spacing="{StaticResource BackSpacing}" HorizontalOptions="Center" BindableLayout.ItemsSource="{Binding Backs}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="game:CardSlot">
                            <Image Source="{Binding ImageSource}" WidthRequest="{StaticResource BackWidth}" HeightRequest="{StaticResource BackHeight}" Aspect="AspectFit" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
                <Border Style="{StaticResource Bubble}" IsVisible="{Binding HasBubble}">
                    <Label Text="{Binding BubbleText}" TextColor="#1A1006" FontSize="12" FontAttributes="Bold" />
                </Border>
                <Label Text="{Binding DeclaredText}" IsVisible="{Binding HasDeclared}" TextColor="#D8C9A0" FontSize="10" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Row 2: West | the trick | East -->
            <Grid Grid.Row="2" ColumnSpacing="4" x:Name="MiddleRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource SideColumn}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource SideColumn}" />
                </Grid.ColumnDefinitions>

                <!-- West -->
                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center" HorizontalOptions="Center" BindingContext="{Binding West}" x:DataType="game:SeatViewModel">
                    <Border Style="{StaticResource Pill}" Opacity="{Binding TurnOpacity}" Padding="6,3">
                        <VerticalStackLayout Spacing="1">
                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource GoldAccentBrush}" HorizontalOptions="Center" IsVisible="{Binding IsToMove}" />
                            <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" />
                            <Label Text="🂠" IsVisible="{Binding IsDealer}" TextColor="{StaticResource GoldHighlight}" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout Spacing="{StaticResource SideBackSpacing}" HorizontalOptions="Center" BindableLayout.ItemsSource="{Binding Backs}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="game:CardSlot">
                                <Image Source="{Binding ImageSource}" WidthRequest="{StaticResource SideBackWidth}" HeightRequest="{StaticResource SideBackHeight}" Aspect="AspectFit" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Border Style="{StaticResource Bubble}" IsVisible="{Binding HasBubble}">
                        <Label Text="{Binding BubbleText}" TextColor="#1A1006" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    </Border>
                    <Label Text="{Binding DeclaredText}" IsVisible="{Binding HasDeclared}" TextColor="#D8C9A0" FontSize="10" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- The trick in progress (and the last trick in the corner) -->
                <Grid Grid.Column="1" MinimumHeightRequest="200">
                    <!-- Last trick: a small cross in the top-left corner -->
                    <VerticalStackLayout HorizontalOptions="Start" VerticalOptions="Start" Spacing="1" IsVisible="{Binding HasLastTrick}">
                        <Label Text="{loc:Tr Game_LastTrick}" FontSize="9" TextColor="#B9C7B0" HorizontalOptions="Center" />
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto" RowSpacing="-8" ColumnSpacing="-2">
                            <Image Grid.Row="0" Grid.Column="1" Source="{Binding LastTrickNorth.ImageSource, FallbackValue='card_back.png'}" WidthRequest="{StaticResource MiniWidth}" HeightRequest="{StaticResource MiniHeight}" />
                            <Image Grid.Row="1" Grid.Column="0" Source="{Binding LastTrickWest.ImageSource, FallbackValue='card_back.png'}" WidthRequest="{StaticResource MiniWidth}" HeightRequest="{StaticResource MiniHeight}" />
                            <Image Grid.Row="1" Grid.Column="2" Source="{Binding LastTrickEast.ImageSource, FallbackValue='card_back.png'}" WidthRequest="{StaticResource MiniWidth}" HeightRequest="{StaticResource MiniHeight}" />
                            <Image Grid.Row="2" Grid.Column="1" Source="{Binding LastTrickSouth.ImageSource, FallbackValue='card_back.png'}" WidthRequest="{StaticResource MiniWidth}" HeightRequest="{StaticResource MiniHeight}" />
                        </Grid>
                    </VerticalStackLayout>

                    <Border x:Name="NorthPlayed" Style="{StaticResource TableCard}" TranslationY="{OnIdiom Phone=-54, Default=-80}" Rotation="-3"
                            IsVisible="{Binding North.HasPlayedCard}">
                        <Image Source="{Binding North.PlayedCard.ImageSource, FallbackValue='card_back.png'}" WidthRequest="{StaticResource TableCardWidth}" HeightRequest="{StaticResource TableCardHeight}" Aspect="AspectFit" />
                    </Border>
                    <Border x:Name="WestPlayed" Style="{StaticResource TableCard}" TranslationX="{OnIdiom Phone=-46, Default=-70}" Rotation="-6"
                            IsVisible="{Binding West.HasPlayedCard}">
                        <Image Source="{Binding West.PlayedCard.ImageSource, FallbackValue='card_back.png'}" WidthRequest="{StaticResource TableCardWidth}" HeightRequest="{StaticResource TableCardHeight}" Aspect="AspectFit" />
                    </Border>
                    <Border x:Name="EastPlayed" Style="{StaticResource TableCard}" TranslationX="{OnIdiom Phone=46, Default=70}" Rotation="5"
                            IsVisible="{Binding East.HasPlayedCard}">
                        <Image Source="{Binding East.PlayedCard.ImageSource, FallbackValue='card_back.png'}" WidthRequest="{StaticResource TableCardWidth}" HeightRequest="{StaticResource TableCardHeight}" Aspect="AspectFit" />
                    </Border>
                    <Border x:Name="SouthPlayed" Style="{StaticResource TableCard}" TranslationY="{OnIdiom Phone=54, Default=80}" Rotation="3"
                            IsVisible="{Binding South.HasPlayedCard}">
                        <Image Source="{Binding South.PlayedCard.ImageSource, FallbackValue='card_back.png'}" WidthRequest="{StaticResource TableCardWidth}" HeightRequest="{StaticResource TableCardHeight}" Aspect="AspectFit" />
                    </Border>

                    <!-- Status pill -->
                    <Border Style="{StaticResource Pill}" BackgroundColor="#3D000000" HorizontalOptions="Center" VerticalOptions="End"
                            IsVisible="{Binding StatusMessage, Converter={StaticResource NotEmpty}}">
                        <Label Text="{Binding StatusMessage}" TextColor="#E6FFFFFF" FontSize="12" HorizontalTextAlignment="Center" />
                    </Border>
                </Grid>

                <!-- East -->
                <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center" HorizontalOptions="Center" BindingContext="{Binding East}" x:DataType="game:SeatViewModel">
                    <Border Style="{StaticResource Pill}" Opacity="{Binding TurnOpacity}" Padding="6,3">
                        <VerticalStackLayout Spacing="1">
                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource GoldAccentBrush}" HorizontalOptions="Center" IsVisible="{Binding IsToMove}" />
                            <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" />
                            <Label Text="🂠" IsVisible="{Binding IsDealer}" TextColor="{StaticResource GoldHighlight}" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout Spacing="{StaticResource SideBackSpacing}" HorizontalOptions="Center" BindableLayout.ItemsSource="{Binding Backs}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="game:CardSlot">
                                <Image Source="{Binding ImageSource}" WidthRequest="{StaticResource SideBackWidth}" HeightRequest="{StaticResource SideBackHeight}" Aspect="AspectFit" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Border Style="{StaticResource Bubble}" IsVisible="{Binding HasBubble}">
                        <Label Text="{Binding BubbleText}" TextColor="#1A1006" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    </Border>
                    <Label Text="{Binding DeclaredText}" IsVisible="{Binding HasDeclared}" TextColor="#D8C9A0" FontSize="10" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- Bidding panel (over the empty South spot of the table) -->
            <Border Grid.Row="2" IsVisible="{Binding IsBidPanelVisible}" x:Name="BidPanel"
                    StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="#F8F4E6"
                    Padding="14,10" HorizontalOptions="Center" VerticalOptions="End" WidthRequest="320">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.5" Radius="14" Offset="0,3" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Tr Game_YourBid}" FontSize="15" FontAttributes="Bold" TextColor="#0B3D1A" HorizontalOptions="Center" />
                    <Label Text="{Binding CurrentBidText}" FontSize="12" TextColor="#6F5A2A" HorizontalOptions="Center" />
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                        <Button Grid.Column="0" BindingContext="{Binding BidOptions[0]}" x:DataType="game:BidOption" Style="{StaticResource BidButton}" Text="♣" FontSize="26"
                                TextColor="{Binding TextColor, Converter={StaticResource HexToColor}}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}"
                                Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                    <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                    <Setter Property="BorderWidth" Value="3" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" BindingContext="{Binding BidOptions[1]}" x:DataType="game:BidOption" Style="{StaticResource BidButton}" Text="♦" FontSize="26"
                                TextColor="{Binding TextColor, Converter={StaticResource HexToColor}}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}"
                                Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                    <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                    <Setter Property="BorderWidth" Value="3" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="2" BindingContext="{Binding BidOptions[2]}" x:DataType="game:BidOption" Style="{StaticResource BidButton}" Text="♥" FontSize="26"
                                TextColor="{Binding TextColor, Converter={StaticResource HexToColor}}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}"
                                Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                    <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                    <Setter Property="BorderWidth" Value="3" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="3" BindingContext="{Binding BidOptions[3]}" x:DataType="game:BidOption" Style="{StaticResource BidButton}" Text="♠" FontSize="26"
                                TextColor="{Binding TextColor, Converter={StaticResource HexToColor}}" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}"
                                Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                    <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                    <Setter Property="BorderWidth" Value="3" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Button Grid.Column="0" BindingContext="{Binding BidOptions[4]}" x:DataType="game:BidOption" Style="{StaticResource BidButton}" Text="{Binding Text}" FontSize="14"
                                TextColor="#1A1006" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}"
                                Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                    <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                    <Setter Property="BorderWidth" Value="3" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" BindingContext="{Binding BidOptions[5]}" x:DataType="game:BidOption" Style="{StaticResource BidButton}" Text="{Binding Text}" FontSize="14"
                                TextColor="#1A1006" IsEnabled="{Binding IsEnabled}" Opacity="{Binding Opacity}"
                                Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                    <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                    <Setter Property="BorderWidth" Value="3" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                        <Button Grid.Column="0" BindingContext="{Binding BidOptions[6]}" x:DataType="game:BidOption" Style="{StaticResource BidButton}" Text="{Binding Text}" FontSize="13"
                                TextColor="#8A1C1C" IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}"
                                Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                    <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                    <Setter Property="BorderWidth" Value="3" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" BindingContext="{Binding BidOptions[7]}" x:DataType="game:BidOption" Style="{StaticResource BidButton}" Text="{Binding Text}" FontSize="13"
                                TextColor="#8A1C1C" IsVisible="{Binding IsVisible}" IsEnabled="{Binding IsEnabled}"
                                Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                    <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
                                    <Setter Property="BorderWidth" Value="3" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="2" BindingContext="{Binding BidOptions[8]}" x:DataType="game:BidOption" Style="{StaticResource BidButton}" Text="{Binding Text}" FontSize="15"
                                BackgroundColor="{StaticResource GoldAccent}" TextColor="#1A1006" IsEnabled="{Binding IsEnabled}"
                                Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.BidCommand}" CommandParameter="{Binding}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsHinted}" Value="True">
                                    <Setter Property="BorderColor" Value="#0B3D1A" />
                                    <Setter Property="BorderWidth" Value="3" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Declaration panel -->
            <Border Grid.Row="2" IsVisible="{Binding IsAnnouncePanelVisible}" x:Name="AnnouncePanel"
                    StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="#F8F4E6"
                    Padding="14,10" HorizontalOptions="Center" VerticalOptions="End" WidthRequest="320">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.5" Radius="14" Offset="0,3" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="6">
                    <Label Text="{loc:Tr Game_YourCombinations}" FontSize="15" FontAttributes="Bold" TextColor="#0B3D1A" HorizontalOptions="Center" />
                    <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding AnnounceOptions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="game:AnnounceOption">
                                <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#14000000" Padding="10,6">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsHinted}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource GoldAccent}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.ToggleAnnounceCommand}" CommandParameter="{Binding}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding Mark}" FontSize="20" TextColor="#0B3D1A" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Text}" FontSize="14" TextColor="#1A1006" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding Points}" FontSize="14" FontAttributes="Bold" TextColor="#6F5A2A" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="{Binding DeclareButtonText}" Command="{Binding DeclareCommand}" HeightRequest="44" CornerRadius="10"
                            FontAttributes="Bold" BackgroundColor="{StaticResource GoldAccent}" TextColor="#1A1006" />
                </VerticalStackLayout>
            </Border>

            <!-- Row 3: South, the person -->
            <Border Grid.Row="3" Style="{StaticResource Pill}" Padding="12,6" BindingContext="{Binding South}" x:DataType="game:SeatViewModel" Opacity="{Binding TurnOpacity}">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                    <Ellipse Grid.Column="0" WidthRequest="10" HeightRequest="10" Fill="{StaticResource GoldAccentBrush}" VerticalOptions="Center" IsVisible="{Binding IsToMove}" />
                    <Label Grid.Column="1" Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="🂠" IsVisible="{Binding IsDealer}" TextColor="{StaticResource GoldHighlight}" FontSize="13" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="3" Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
                        <Border Style="{StaticResource Bubble}" IsVisible="{Binding HasBubble}">
                            <Label Text="{Binding BubbleText}" TextColor="#1A1006" FontSize="12" FontAttributes="Bold" />
                        </Border>
                        <Label Text="{Binding DeclaredText}" IsVisible="{Binding HasDeclared}" TextColor="#D8C9A0" FontSize="10" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>
            <Button Grid.Row="3" Text="{loc:Tr Game_Hint}" Command="{Binding HintCommand}" IsVisible="{Binding IsHintVisible}"
                    HorizontalOptions="End" VerticalOptions="Center" HeightRequest="32" FontSize="12" FontAttributes="Bold" Padding="12,0" Margin="0,0,6,0"
                    CornerRadius="10" BackgroundColor="#26FFFFFF" BorderColor="{StaticResource GoldAccent}" BorderWidth="1" TextColor="{StaticResource GoldHighlight}" />

            <!-- Row 4: my hand -->
            <HorizontalStackLayout Grid.Row="4" Spacing="{StaticResource HandSpacing}" HorizontalOptions="Center" BindableLayout.ItemsSource="{Binding MyHand}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="game:CardSlot">
                        <Border StrokeThickness="0" Stroke="Transparent" StrokeShape="RoundRectangle 6" BackgroundColor="Transparent"
                                Opacity="{Binding IsPlayable, Converter={StaticResource BoolToOpacity}}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsHinted}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource GoldHighlight}" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.6" Radius="8" Offset="2,3" />
                            </Border.Shadow>
                            <Grid>
                                <Image Source="{Binding ImageSource}" WidthRequest="{StaticResource HandCardWidth}" HeightRequest="{StaticResource HandCardHeight}" Aspect="AspectFit" />
                                <Border IsVisible="{Binding HasBadge}" StrokeShape="RoundRectangle 6" StrokeThickness="0" BackgroundColor="{StaticResource GoldHighlight}"
                                        Padding="4,1" HorizontalOptions="Start" VerticalOptions="End" Margin="3,0,0,4">
                                    <Label Text="{Binding BadgeText}" TextColor="#1A1006" FontSize="9" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.TapCardCommand}" CommandParameter="{Binding}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </Grid>

        <!-- ===== Menu button ===== -->
        <Button Text="{loc:Tr Game_Menu}" Clicked="OnMenuClicked" HorizontalOptions="End" VerticalOptions="Start" Margin="0,10,10,0"
                HeightRequest="36" WidthRequest="52" FontSize="12" Padding="0" CornerRadius="10"
                BackgroundColor="#88000000" BorderColor="#55FFFFFF" BorderWidth="1" TextColor="White" />

        <!-- ===== Toast ===== -->
        <Border x:Name="ToastBorder" IsVisible="{Binding IsToastVisible}" StrokeShape="RoundRectangle 16" Stroke="#1A1006" StrokeThickness="2"
                BackgroundColor="{StaticResource GoldHighlight}" Padding="26,14" HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="420"
                InputTransparent="True">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.7" Radius="20" Offset="0,4" />
            </Border.Shadow>
            <Label Text="{Binding ToastMessage}" TextColor="#1A1006" FontAttributes="Bold" FontSize="22" HorizontalTextAlignment="Center" />
        </Border>

        <!-- ===== End of a deal ===== -->
        <Grid x:Name="RoundOverlayRoot" IsVisible="{Binding IsRoundOverlayVisible}" BackgroundColor="#D9000000">
            <ScrollView VerticalOptions="Center">
                <Border StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="#F8F4E6" Padding="22,20" Margin="16"
                        HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="420" BindingContext="{Binding RoundResult}" x:DataType="game:RoundResultModel">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding Icon}" FontSize="44" HorizontalOptions="Center" />
                        <Label Text="{Binding Title}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="#0B3D1A" />
                        <Label Text="{Binding ContractLine}" FontSize="14" HorizontalOptions="Center" TextColor="#6F5A2A" />
                        <Border IsVisible="{Binding IsCapot}" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#C0504D" Padding="12,3" HorizontalOptions="Center">
                            <Label Text="{loc:Tr Round_CapotBadge}" TextColor="White" FontAttributes="Bold" FontSize="14" />
                        </Border>

                        <Border IsVisible="{Binding IsPlayed}" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#0B3D1A" Padding="14,10">
                            <Grid ColumnDefinitions="*,70,70" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                <Label Grid.Row="0" Grid.Column="1" Text="{loc:Tr Game_Us}" TextColor="#E2B864" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Grid.Row="0" Grid.Column="2" Text="{loc:Tr Game_Them}" TextColor="#E2B864" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{loc:Tr Round_Cards}" TextColor="#C7D2BD" FontSize="13" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding UsCards}" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Row="1" Grid.Column="2" Text="{Binding ThemCards}" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Row="2" Grid.Column="0" Text="{loc:Tr Round_Combinations}" TextColor="#C7D2BD" FontSize="13" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding UsCombinations}" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Row="2" Grid.Column="2" Text="{Binding ThemCombinations}" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Row="3" Grid.Column="0" Text="{loc:Tr Round_Capot}" TextColor="#C7D2BD" FontSize="13" />
                                <Label Grid.Row="3" Grid.Column="1" Text="{Binding UsCapot}" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Row="3" Grid.Column="2" Text="{Binding ThemCapot}" TextColor="White" HorizontalOptions="Center" />
                                <Label Grid.Row="4" Grid.Column="0" Text="{loc:Tr Round_InDeal}" TextColor="#E2B864" FontSize="13" FontAttributes="Bold" />
                                <Label Grid.Row="4" Grid.Column="1" Text="{Binding UsInDeal}" TextColor="{StaticResource GoldHighlight}" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Grid.Row="4" Grid.Column="2" Text="{Binding ThemInDeal}" TextColor="{StaticResource GoldHighlight}" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Grid.Row="5" Grid.Column="0" Text="{loc:Tr Round_GamePoints}" TextColor="#E2B864" FontSize="13" FontAttributes="Bold" />
                                <Label Grid.Row="5" Grid.Column="1" Text="{Binding UsAwarded}" TextColor="{StaticResource GoldHighlight}" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" />
                                <Label Grid.Row="5" Grid.Column="2" Text="{Binding ThemAwarded}" TextColor="{StaticResource GoldHighlight}" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout IsVisible="{Binding HasCombinations}" Spacing="2">
                            <Label FontSize="12" TextColor="#1A1006" HorizontalTextAlignment="Center" IsVisible="{Binding HasUsCombinations}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{loc:Tr Game_Us}" FontAttributes="Bold" />
                                        <Span Text=": " />
                                        <Span Text="{Binding UsCombinationsText}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="12" TextColor="#1A1006" HorizontalTextAlignment="Center" IsVisible="{Binding HasThemCombinations}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{loc:Tr Game_Them}" FontAttributes="Bold" />
                                        <Span Text=": " />
                                        <Span Text="{Binding ThemCombinationsText}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>

                        <Label Text="{Binding HangingText}" IsVisible="{Binding HasHanging}" FontSize="13" TextColor="#6F5A2A" HorizontalOptions="Center" HorizontalTextAlignment="Center" />

                        <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="{StaticResource GoldAccent}" Padding="16,6">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="{loc:Tr Round_Score}" FontSize="11" CharacterSpacing="2" HorizontalOptions="Center" TextColor="#7A5C20" />
                                <Label HorizontalOptions="Center" TextColor="#1A1006" FontSize="22" FontAttributes="Bold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding UsTotal}" />
                                            <Span Text="  –  " />
                                            <Span Text="{Binding ThemTotal}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <Button Text="{loc:Tr Common_Continue}" Command="{Binding Source={x:Reference ThePage}, Path=BindingContext.RoundOverlayContinueCommand}"
                                BackgroundColor="{StaticResource GoldAccent}" TextColor="#1A1006" FontAttributes="Bold" FontSize="17" HeightRequest="50" CornerRadius="12" />
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <!-- ===== End of the game ===== -->
        <Grid x:Name="GameOverlayRoot" IsVisible="{Binding IsGameOverlayVisible}" BackgroundColor="#E5000000">
            <Border StrokeShape="RoundRectangle 22" StrokeThickness="0" BackgroundColor="#F8F4E6" Padding="28,26" Margin="16"
                    HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="420">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.7" Radius="24" Offset="0,4" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    <Label Text="{Binding GameOverlayIcon}" FontSize="52" HorizontalOptions="Center" />
                    <Label Text="{Binding GameOverlayTitle}" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#0B3D1A" />
                    <Label Text="{Binding GameOverlayBody}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="#1A1006" />
                    <Border IsVisible="{Binding IsRatingChangeVisible}" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="#0B3D1A" Padding="16,10">
                        <Label Text="{Binding RatingChangeText}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="{StaticResource GoldHighlight}" />
                    </Border>
                    <Border IsVisible="{Binding HasMatchHistory}" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#22000000" Padding="12,5" HorizontalOptions="Center">
                        <Label FontSize="13" TextColor="#0B3D1A" FontAttributes="Bold">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{loc:Tr Common_Series}" />
                                    <Span Text="  " />
                                    <Span Text="{Binding MatchScoreText}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                    <Button Text="{loc:Tr GameOver_PlayAgain}" Command="{Binding PlayAgainCommand}" BackgroundColor="{StaticResource GoldAccent}" TextColor="#1A1006"
                            FontAttributes="Bold" FontSize="17" HeightRequest="50" CornerRadius="12" />
                    <Button Text="{loc:Tr GameOver_BackToMenu}" Command="{Binding LeaveCommand}" BackgroundColor="Transparent" BorderColor="{StaticResource FeltMid}" BorderWidth="1"
                            TextColor="{StaticResource FeltMid}" FontAttributes="Bold" FontSize="15" HeightRequest="46" CornerRadius="12" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
